---
import type { ImageMetadata } from "astro";
import "swiper/css";
import "swiper/css/free-mode";
import "swiper/css/navigation";
import "swiper/css/thumbs";
import "photoswipe/style.css";

interface Slide {
    src: ImageMetadata;
    alt: string;
    caption: string;
}

interface Props {
    slides: Slide[];
    ariaLabel?: string;
}

const { slides, ariaLabel = "Product screenshots" } = Astro.props;
---

<div class="screenshots-carousel" data-screenshots-carousel>
    <swiper-container
            class="screenshots-swiper"
            data-main-swiper
            init="false"
            aria-label={ariaLabel}
    >
        {slides.map((slide) => (
                <swiper-slide>
                    <figure class="screenshots-slide">
                        <a
                                class="screenshots-link"
                                href={slide.src.src}
                                data-pswp-width={slide.src.width}
                                data-pswp-height={slide.src.height}
                                target="_blank"
                                rel="noreferrer"
                        >
                            <img
                                    src={slide.src.src}
                                    width={slide.src.width}
                                    height={slide.src.height}
                                    alt={slide.alt}
                                    loading="lazy"
                            />
                        </a>
                        <figcaption>{slide.caption}</figcaption>
                    </figure>
                </swiper-slide>
        ))}
    </swiper-container>

    <swiper-container
            class="screenshots-thumbs"
            data-thumbs-swiper
            init="false"
            aria-label="Screenshot thumbnails"
    >
        {slides.map((slide) => (
                <swiper-slide>
                    <img
                            src={slide.src.src}
                            width={slide.src.width}
                            height={slide.src.height}
                            alt={slide.alt}
                            loading="lazy"
                    />
                </swiper-slide>
        ))}
    </swiper-container>
</div>

<script>
    import { register } from "swiper/element/bundle";
    import PhotoSwipeLightbox from "photoswipe/lightbox";

    register();

    document.querySelectorAll("[data-screenshots-carousel]").forEach((root) => {
        const mainSwiper = root.querySelector("[data-main-swiper]");
        const thumbsSwiper = root.querySelector("[data-thumbs-swiper]");

        if (!mainSwiper || !thumbsSwiper) {
            return;
        }

        Object.assign(thumbsSwiper, {
            spaceBetween: 8,
            freeMode: true,
            watchSlidesProgress: true,
            breakpoints: {
                0: { slidesPerView: 4 },
                640: { slidesPerView: 6 },
                960: { slidesPerView: 8 }
            }
        });
        thumbsSwiper.initialize();

        Object.assign(mainSwiper, {
            navigation: true,
            keyboard: { enabled: true },
            spaceBetween: 18,
            slidesPerView: 1,
            thumbs: { swiper: thumbsSwiper.swiper }
        });
        mainSwiper.initialize();

        const lightbox = new PhotoSwipeLightbox({
            gallery: root,
            children: ".screenshots-link",
            pswpModule: () => import("photoswipe")
        });

        lightbox.init();
    });
</script>

<style>
    .screenshots-carousel {
        max-width: 68rem;
        margin: 0 auto;
    }

    .screenshots-slide {
        margin: 0;
        display: grid;
        gap: 0.75rem;
        justify-items: center;
    }

    .screenshots-link {
        display: block;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 8px;
        overflow: hidden;
        max-width: min(72vw, 860px);
        background: #14192a;
    }

    .screenshots-link img {
        display: block;
        width: 100%;
        height: auto;
    }

    .screenshots-slide figcaption {
        color: var(--hero-color);
        text-align: center;
    }

    .screenshots-swiper::part(button-prev),
    .screenshots-swiper::part(button-next) {
        color: #edf1ff;
    }

    .screenshots-thumbs {
        margin-top: 0.9rem;
        max-width: min(72vw, 860px);
        margin-left: auto;
        margin-right: auto;
    }

    .screenshots-thumbs swiper-slide {
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 8px;
        overflow: hidden;
        opacity: 0.65;
        cursor: pointer;
    }

    .screenshots-thumbs .swiper-slide-thumb-active {
        opacity: 1;
        border-color: #edf1ff;
    }

    .screenshots-thumbs img {
        display: block;
        width: 100%;
        height: auto;
    }
</style>
